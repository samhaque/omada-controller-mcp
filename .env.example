OMADA_BASE_URL=https://your-controller.local:8043
OMADA_VERIFY_SSL=false

# Either set the value directly, or point *_FILE at a file holding it (Docker
# secrets, Kubernetes Secret volume, Vault agent, etc.) - used only when the
# direct var is unset.
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# OMADA_CLIENT_ID_FILE=/run/secrets/omada_client_id
# OMADA_CLIENT_SECRET_FILE=/run/secrets/omada_client_secret

# Required if this server is reachable beyond localhost (e.g. the Docker/LAN
# deployment): without it, anyone who can reach the MCP HTTP port can drive
# the whole Omada API with no credential of their own. Generate one with:
#   openssl rand -hex 32
# and pass the same value as a Bearer token when connecting an MCP client.
OMADA_MCP_AUTH_TOKEN=

# Optional, HTTP transport only. Max requests/second before a client gets
# rate-limited (defense against brute force / DoS on an untrusted LAN).
# OMADA_MCP_RATE_LIMIT=20

# Optional, HTTP transport only. Comma-separated Host header allowlist, on
# top of FastMCP's built-in DNS-rebinding protection. Leave unset unless you
# need it.
# OMADA_MCP_ALLOWED_HOSTS=omada-mcp.local,192.168.1.50
